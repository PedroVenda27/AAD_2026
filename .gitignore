# Build artifacts (generated by make in any Px folder)
*.o
*.class
*.pyc
*.wasm
*.pgm
a.out

# Mandelbrot compiled binaries (extensionless, generated by make)
# listed explicitly by name (not by glob) so they don't accidentally match
# source files such as MandelbrotCountCrit.c or MandelbrotCountVert.c
MandelbrotCount
MandelbrotCountCgcc
MandelbrotCountCOgcc
MandelbrotCountCclang
MandelbrotCountCOclang
MandelbrotCountF
MandelbrotCountFO
MandelbrotCountM
MandelbrotCountM.py
MandelbrotCountR
MandelbrotCountRO
MandelbrotCountZ
MandelbrotCountZO
MandelbrotCount.html
MandelbrotCount.js
MandelbrotCountSeq
MandelbrotCountVert
MandelbrotCountHoriz
MandelbrotCountCrit
MandelbrotCountProdCons

# P2 pthread example binaries (extensionless, generated by make)
create_and_join
lock_and_unlock
producer_consumer

# P3 OpenMP example binaries (extensionless, generated by make)
create_and_join.s
reduction
tasks
MandelbrotCountOMP

# Third-party installer scripts (not part of the lab source)
install-codon.sh
install.bash

# OS junk
Thumbs.db
.DS_Store
